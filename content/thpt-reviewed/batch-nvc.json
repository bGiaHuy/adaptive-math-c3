      "questionType": "SINGLE_CHOICE",
      "content": "Cho tam giác $ABC$ có $BC=a$, $AB=c$, $AC=b$ và $R$ là bán kính đường tròn ngoại tiếp. Hệ thức nào sau đây sai?",
      "explanation": "Định lí sin cho a/sin A = b/sin B = c/sin C = 2R, suy ra A, B, C đúng. Hệ thức ở D không phải định lí sin.",
      "difficulty": "EASY",
      "cognitiveLevel": "UNDERSTANDING",
      "options": [
        {
          "key": "A",
          "content": "$\\sin A=\\dfrac{a}{2R}$"
        },
        {
          "key": "B",
          "content": "$\\sin C=\\dfrac{c\\sin A}{a}$"
        },
        {
          "key": "C",
          "content": "$\\dfrac{a}{\\sin A}=2R$"
        },
        {
          "key": "D",
          "content": "$b\\sin B=2R$"
        }
      ],
      "correctOption": "D",
