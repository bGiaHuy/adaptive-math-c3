    {
      "externalId": "THPT-10-GIUA_HK1-006-Q05",
      "grade": 10,
      "skillCode": "KNTT-10-C03-T02",
      "questionType": "SINGLE_CHOICE",
      "content": "Cho tam giác $ABC$ có $AB=c$, $AC=b$, $BC=a$. Gọi $S,p$ lần lượt là diện tích và nửa chu vi. Phát biểu nào sau đây sai?",
      "explanation": "Định lí sin dùng b/sin B, không phải b/cos B. A là công thức Heron, B là định lí côsin và D là công thức diện tích theo hai cạnh và góc xen giữa.",
      "difficulty": "EASY",
      "cognitiveLevel": "UNDERSTANDING",
      "options": [
        {
          "key": "A",
          "content": "$S=\\sqrt{p(p-a)(p-b)(p-c)}$"
        },
        {
          "key": "B",
          "content": "$a^2+b^2-c^2=2ab\\cos C$"
        },
        {
          "key": "C",
          "content": "$\\dfrac a{\\sin A}=\\dfrac b{\\cos B}=\\dfrac c{\\sin C}$"
        },
        {
          "key": "D",
          "content": "$S=\\dfrac12ab\\sin C$"
        }
      ],
      "correctOption": "C",
