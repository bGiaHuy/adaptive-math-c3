{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adaptive-math-c3-candidate",
  "account_id": "dd2f7a1c403332569d3a1058ab9dd3d2",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "vars": { "API_INSTANCE": "sonnet-validation-20261109" },
  "ratelimits": [{ "name": "AUTH_RATE_LIMITER", "namespace_id": "3444001", "simple": { "limit": 120, "period": 60 } }],
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "single-page-application"
  },
  "containers": [{
    "class_name": "C3Api",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "Dockerfile", "build_context": "../.." } }
  }],
  "durable_objects": { "bindings": [{ "name": "API", "class_name": "C3Api" }] },
  "exports": { "C3Api": { "type": "durable-object", "storage": "sqlite" } },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
