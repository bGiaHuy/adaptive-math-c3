{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adaptive-math-c3-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "single-page-application"
  },
  "containers": [{
    "class_name": "C3Api",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "Dockerfile", "build_context": "../.." } }
  }],
  "durable_objects": { "bindings": [{ "name": "API", "class_name": "C3Api" }] },
  "exports": { "C3Api": { "type": "durable-object", "storage": "sqlite" } },
  "observability": { "enabled": true }
}
